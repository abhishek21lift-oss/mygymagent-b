// ============================================================================
// MyGymAgent - Core Platform Schema
//
// Multi-tenancy, RBAC, auth, audit logging, and the core gym domain
// (organizations, branches, staff, members, membership plans/subscriptions,
// attendance) plus billing (payments/refunds), workouts, nutrition,
// inventory, CRM/leads, AI usage tracking, a BullMQ job queue, Member
// 360 (addresses, emergency contacts, notes, consents, status/branch/
// trainer history, assessments/measurements/fitness tests/screenings,
// goals/milestones, documents/progress photos), and a real communications
// layer (templates, per-org branding, delivery logging, consent
// enforcement -- EMAIL is provider-backed today; WHATSAPP/SMS/PUSH are
// typed but unimplemented, see src/communications/README.md) are modeled
// and built.
//
// Still reserved seams, not modeled here yet (see
// docs/architecture/discovery-report.md for the current gap list):
// search, analytics, platform SaaS billing (as opposed to the gym-side
// Payment/Refund tables below), Appointments. New tables all hang off
// Organization / Branch / Member / User the same way the tables below do,
// keeping tenant isolation uniform across the system.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Tenancy root
// ----------------------------------------------------------------------------

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// The top-level tenant. Every tenant-owned row is reachable from an
/// Organization, directly or via Branch. Row access is always scoped by
/// organizationId server-side (see TenantContext / PrismaService) -- never
/// by client-supplied filters alone.
model Organization {
  id       String             @id @default(uuid())
  name     String
  slug     String             @unique
  status   OrganizationStatus @default(TRIAL)
  timezone String             @default("UTC")
  currency String             @default("USD")

  /// Self-relation so a franchise / holding company can group multiple
  /// legal-entity organizations together without collapsing their data.
  parentOrganizationId String?
  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[] @relation("OrganizationHierarchy")

  settings Json @default("{}")

  /// Tenant email branding, used by the communications layer
  /// (src/communications/) when rendering a template for this org -- falls
  /// back to the platform default sender identity when unset. Nullable
  /// rather than folded into `settings` so it's a typed, queryable column
  /// like the rest of this schema, not an unmanaged JSON blob.
  emailFromName String?
  emailReplyTo  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches                Branch[]
  users                   User[]
  members                 Member[]
  roles                   Role[]
  membershipPlans         MembershipPlan[]
  memberships             Membership[]
  attendances             Attendance[]
  auditLogs               AuditLog[]
  userRoles               UserRole[]
  payments                Payment[]
  refunds                 Refund[]
  exercises               Exercise[]
  workoutPlans            WorkoutPlan[]
  workoutAssignments      WorkoutAssignment[]
  leads                   Lead[]
  leadFollowUps           LeadFollowUp[]
  foodItems               FoodItem[]
  dietPlans               DietPlan[]
  dietAssignments         DietAssignment[]
  products                Product[]
  stockMovements          StockMovement[]
  aiUsageLogs             AiUsageLog[]
  memberAddresses         MemberAddress[]
  memberEmergencyContacts MemberEmergencyContact[]
  memberNotes             MemberNote[]
  memberConsents          MemberConsent[]
  memberStatusHistory     MemberStatusHistory[]
  memberBranchHistory     MemberBranchHistory[]
  memberTrainerHistory    MemberTrainerHistory[]
  memberAssessments       MemberAssessment[]
  memberMeasurements      MemberMeasurement[]
  memberFitnessResults    MemberFitnessTestResult[]
  memberScreenings        MemberScreening[]
  memberGoals             MemberGoal[]
  memberGoalMilestones    MemberGoalMilestone[]
  files                   File[]
  memberDocuments         MemberDocument[]
  messageTemplates        MessageTemplate[]
  messageLogs             MessageLog[]
  automationRuns          AutomationRun[]
  aiActions               AiAction[]
  aiConversations         AiConversation[]
  ptSessions            PtSession[]   @relation("PtSession")

  @@index([parentOrganizationId])
  @@map("organizations")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  status   BranchStatus @default(ACTIVE)
  timezone String?
  phone    String?
  email    String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  staffProfiles           StaffProfile[]
  membershipPlans         MembershipPlan[]
  memberships             Membership[]
  attendances             Attendance[]
  userRoles               UserRole[]
  payments                Payment[]
  ptSessions              PtSession[] @relation("PtSession")
  leads                   Lead[]
  primaryUsers            User[]                @relation("UserPrimaryBranch")
  primaryMembers          Member[]              @relation("MemberPrimaryBranch")
  memberBranchHistoryTo   MemberBranchHistory[] @relation("MemberBranchHistoryTo")
  memberBranchHistoryFrom MemberBranchHistory[] @relation("MemberBranchHistoryFrom")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("branches")
}

// ----------------------------------------------------------------------------
// Identity, auth, RBAC
// ----------------------------------------------------------------------------

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

/// A login identity. Staff, trainers, org admins and platform admins are all
/// Users. Gym clients are modeled separately as Member (see below) and only
/// gain a User row if/when member-portal login is enabled for them.
model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Set only for platform-level staff (organizationId is null for these).
  platformRole PlatformRole?

  email        String  @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?

  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  primaryBranchId String?
  primaryBranch   Branch? @relation("UserPrimaryBranch", fields: [primaryBranchId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  staffProfile             StaffProfile?
  member                   Member?                   @relation("MemberPortalUser")
  userRoles                UserRole[]
  permissionOverrides      UserPermissionOverride[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  auditLogsAsActor         AuditLog[]                @relation("AuditActor")
  assignedMembers          Member[]                  @relation("MemberAssignedTrainer")
  recordedAttendances      Attendance[]              @relation("AttendanceRecordedBy")
  staffAttendances         Attendance[]              @relation("AttendanceStaffUser")
  paymentsRecorded         Payment[]                 @relation("PaymentRecordedBy")
  refundsRecorded          Refund[]                  @relation("RefundRecordedBy")
  workoutPlansCreated      WorkoutPlan[]             @relation("WorkoutPlanCreatedBy")
  workoutAssignmentsMade   WorkoutAssignment[]       @relation("WorkoutAssignedBy")
  leadsAssigned            Lead[]                    @relation("LeadAssignedTo")
  leadFollowUpsCreated     LeadFollowUp[]            @relation("LeadFollowUpCreatedBy")
  dietPlansCreated         DietPlan[]                @relation("DietPlanCreatedBy")
  dietAssignmentsMade      DietAssignment[]          @relation("DietAssignedBy")
  stockMovementsRecorded   StockMovement[]           @relation("StockMovementRecordedBy")
  aiUsageLogs              AiUsageLog[]              @relation("AiUsageActor")
  memberNotesAuthored      MemberNote[]              @relation("MemberNoteAuthor")
  memberConsentsRecorded   MemberConsent[]           @relation("MemberConsentRecordedBy")
  memberStatusChangesMade  MemberStatusHistory[]     @relation("MemberStatusChangedBy")
  memberBranchChangesMade  MemberBranchHistory[]     @relation("MemberBranchChangedBy")
  memberTrainerChangesMade MemberTrainerHistory[]    @relation("MemberTrainerChangedBy")
  memberTrainerHistoryFrom MemberTrainerHistory[]    @relation("MemberTrainerHistoryFrom")
  memberTrainerHistoryTo   MemberTrainerHistory[]    @relation("MemberTrainerHistoryTo")
  assessmentsConducted     MemberAssessment[]        @relation("AssessmentConductedBy")
  measurementsRecorded     MemberMeasurement[]       @relation("MeasurementRecordedBy")
  fitnessTestsRecorded     MemberFitnessTestResult[] @relation("FitnessTestRecordedBy")
  screeningsRecorded       MemberScreening[]         @relation("ScreeningRecordedBy")
  goalsCreated             MemberGoal[]              @relation("GoalCreatedBy")
  filesUploaded            File[]                    @relation("FileUploadedBy")
  aiActionsProposed        AiAction[]                @relation("AiActionProposedBy")
  aiActionsDecided         AiAction[]                @relation("AiActionDecidedBy")
  aiConversations          AiConversation[]

  @@index([organizationId])
  @@map("users")
}

/// Staff/trainer-specific fields, kept off User to keep the auth identity lean.
model StaffProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id])

  employeeCode    String?
  jobTitle        String?
  isTrainer       Boolean   @default(false)
  specializations String[]  @default([])
  bio             String?
  commissionRate  Decimal?  @db.Decimal(5, 2)
  hireDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("staff_profiles")

  ptSessions PtSession[] @relation("PtSession")
}

/// Permission catalog, e.g. "members.read", "payments.refund". Global, not
/// tenant-scoped -- every organization draws from the same catalog.
model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([resource])
  @@map("permissions")
}

/// A role is either a system role (organizationId null, seeded once and
/// available to every tenant) or a custom role an organization defines for
/// itself (organizationId set).
model Role {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Assigns a role to a user, optionally scoped to a single branch (e.g.
/// "Branch Manager at Branch X" vs. an organization-wide role).
model UserRole {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId, branchId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_roles")
}

enum PermissionEffect {
  ALLOW
  DENY
}

/// Per-user exceptions layered on top of role-derived permissions. DENY
/// always wins over ALLOW so an org admin can carve out an exception without
/// redesigning the role graph.
model UserPermissionOverride {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  organizationId String
  branchId       String?
  effect         PermissionEffect

  createdAt DateTime @default(now())

  @@unique([userId, permissionId, branchId])
  @@map("user_permission_overrides")
}

/// One row per issued refresh token / device session -- enables device
/// listing and "log out everywhere".
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ----------------------------------------------------------------------------
// Audit log
// ----------------------------------------------------------------------------

/// Immutable record of sensitive actions. Never updated or deleted by
/// application code.
model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?

  actorUserId String?
  actorUser   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  resource   String
  resourceId String?

  beforeState Json?
  afterState  Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Core gym domain: members, membership plans/subscriptions, attendance
// ----------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  FROZEN
  EXPIRED
}

model Member {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryBranchId String
  primaryBranch   Branch       @relation("MemberPrimaryBranch", fields: [primaryBranchId], references: [id])

  memberCode String

  firstName String
  lastName  String
  email     String?
  phone     String?

  dateOfBirth DateTime?
  gender      Gender?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  emergencyContactName  String?
  emergencyContactPhone String?

  profilePhotoUrl String?
  status          MemberStatus @default(ACTIVE)

  assignedTrainerId String?
  assignedTrainer   User?   @relation("MemberAssignedTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)

  /// Set only if/when this member is granted member-portal login.
  userId String? @unique
  user   User?   @relation("MemberPortalUser", fields: [userId], references: [id], onDelete: SetNull)

  notes String?

  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships        Membership[]
  attendances        Attendance[]
  payments           Payment[]
  workoutAssignments WorkoutAssignment[]
  dietAssignments    DietAssignment[]
  ptSessions         PtSession[]   @relation("PtSession")
  /// Set if this member originated from a converted Lead -- the opposite
  /// side of Lead.convertedMemberId.
  convertedFromLead  Lead?

  addresses         MemberAddress[]
  emergencyContacts MemberEmergencyContact[]
  memberNotes       MemberNote[]
  consents          MemberConsent[]
  statusHistory     MemberStatusHistory[]
  branchHistory     MemberBranchHistory[]
  trainerHistory    MemberTrainerHistory[]
  assessments       MemberAssessment[]
  measurements      MemberMeasurement[]
  fitnessResults    MemberFitnessTestResult[]
  screenings        MemberScreening[]
  goals             MemberGoal[]
  documents         MemberDocument[]
  messageLogs       MessageLog[]

  @@unique([organizationId, memberCode])
  @@index([organizationId, primaryBranchId])
  @@index([assignedTrainerId])
  @@map("members")
}

// ----------------------------------------------------------------------------
// Member 360 -- sub-entities that preserve history the flat Member fields
// above cannot (addressLine1/emergencyContactName/notes/status/
// primaryBranchId/assignedTrainerId are still the "current value" fields;
// these tables are the collection/history layer around them). See
// docs/architecture/discovery-report.md §6 for why this exists.
// ----------------------------------------------------------------------------

enum MemberAddressType {
  HOME
  WORK
  BILLING
  OTHER
}

/// A member can have more than one address (billing vs. home, etc.) --
/// unlike Member.addressLine1 etc., which remain a single denormalized
/// "current primary" snapshot for quick display. Ordinary address-book
/// data, not financial/compliance history, so rows can be deleted outright
/// (no soft-delete/immutability requirement here, unlike MemberConsent).
model MemberAddress {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type      MemberAddressType @default(HOME)
  isPrimary Boolean           @default(false)

  addressLine1 String
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, memberId])
  @@map("member_addresses")
}

/// Same rationale as MemberAddress -- Member.emergencyContactName/Phone
/// stay as the single "current primary" snapshot; this is the collection.
model MemberEmergencyContact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name         String
  phone        String
  relationship String?
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, memberId])
  @@map("member_emergency_contacts")
}

/// Replaces Member.notes (a single overwritable field -- a second note
/// used to destroy the first) with an authored, timestamped collection.
/// Member.notes is left in place as a legacy field, not backfilled or
/// removed here -- see the migration note in members.service.ts.
model MemberNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorUser   User?   @relation("MemberNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  body   String
  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, memberId, createdAt])
  @@map("member_notes")
}

enum MemberConsentType {
  WAIVER
  MARKETING
  PHOTO_RELEASE
  DATA_PROCESSING
  OTHER
}

/// Append-only, like Payment/Membership -- revoking a consent inserts a
/// new row with granted=false rather than mutating the original grant, so
/// "what did this member consent to, and when" is always reconstructable
/// from history, never a single mutable boolean.
model MemberConsent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type    MemberConsentType
  granted Boolean
  note    String?

  recordedByUserId String?
  recordedByUser   User?   @relation("MemberConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, type])
  @@map("member_consents")
}

/// Append-only. One row per Member.status transition, written by
/// MembersService whenever status actually changes -- never edited in
/// place, so "when did this member become INACTIVE, and who changed it"
/// survives the flat Member.status field being overwritten.
model MemberStatusHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromStatus MemberStatus?
  toStatus   MemberStatus

  changedByUserId String?
  changedByUser   User?   @relation("MemberStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  reason          String?

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, createdAt])
  @@map("member_status_history")
}

/// Append-only. Same pattern as MemberStatusHistory, for
/// Member.primaryBranchId transfers.
model MemberBranchHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromBranchId String?
  fromBranch   Branch? @relation("MemberBranchHistoryFrom", fields: [fromBranchId], references: [id], onDelete: SetNull)
  toBranchId   String
  toBranch     Branch  @relation("MemberBranchHistoryTo", fields: [toBranchId], references: [id])

  changedByUserId String?
  changedByUser   User?   @relation("MemberBranchChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  reason          String?

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, createdAt])
  @@map("member_branch_history")
}

/// Append-only. Same pattern again, for Member.assignedTrainerId changes
/// -- closes the "changing a trainer must not destroy history" gap called
/// out in docs/architecture/discovery-report.md §6.
model MemberTrainerHistory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromTrainerId String?
  fromTrainer   User?   @relation("MemberTrainerHistoryFrom", fields: [fromTrainerId], references: [id], onDelete: SetNull)
  toTrainerId   String?
  toTrainer     User?   @relation("MemberTrainerHistoryTo", fields: [toTrainerId], references: [id], onDelete: SetNull)

  changedByUserId String?
  changedByUser   User?   @relation("MemberTrainerChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  reason          String?

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, createdAt])
  @@map("member_trainer_history")
}

model MembershipPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Null means available across all branches of the organization.
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  durationDays  Int
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  benefits      String[] @default([])
  maxFreezeDays Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([organizationId, branchId])
  @@map("membership_plans")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

/// A member's subscription to a plan. Price is snapshotted at purchase time
/// so historical financial records never drift when the plan's price
/// changes later. Freezes/upgrades/transfers create a new Membership row
/// linked via previousMembershipId rather than mutating history in place.
model Membership {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  memberId         String
  member           Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  status MembershipStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime

  freezeStartDate     DateTime?
  freezeEndDate       DateTime?
  totalFreezeDaysUsed Int       @default(0)

  price     Decimal @db.Decimal(10, 2)
  currency  String  @default("USD")
  autoRenew Boolean @default(false)

  cancelledAt        DateTime?
  cancellationReason String?

  previousMembershipId String?     @unique
  previousMembership   Membership? @relation("MembershipChain", fields: [previousMembershipId], references: [id])
  nextMembership       Membership? @relation("MembershipChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([organizationId, branchId])
  @@index([memberId])
  @@index([status, endDate])
  @@map("memberships")
}

enum AttendanceMethod {
  QR
  MANUAL
  KIOSK
  APP
  STAFF
}

/// Check-in/out for both members and staff (exactly one of memberId /
/// staffUserId is set).
model Attendance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  memberId    String?
  member      Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffUserId String?
  staffUser   User?   @relation("AttendanceStaffUser", fields: [staffUserId], references: [id], onDelete: Cascade)

  checkInAt  DateTime         @default(now())
  checkOutAt DateTime?
  method     AttendanceMethod @default(MANUAL)

  recordedByUserId String?
  recordedByUser   User?   @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, branchId, checkInAt])
  @@index([memberId, checkInAt])
  @@map("attendances")
}

// ----------------------------------------------------------------------------
// Gym operational billing: member payments and refunds. NOT the same thing
// as platform billing (what a gym pays this SaaS) -- see
// docs/saas/billing-separation.md for why those are deliberately separate
// model families, not one shared "Transaction" table.
// ----------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

/// A member paying the gym (membership fee, PT session, product, ...).
/// Immutable once created: amount/currency never change after the fact --
/// a refund is a new linked Refund row, never a mutation of this row. See
/// docs/database/data-retention.md's financial-records section.
model Payment {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId               String?
  branch                 Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId               String
  member                 Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Nullable: a payment can be a one-off (PT session, product) not tied to
  /// a membership purchase/renewal.
  membershipId           String?
  membership             Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  /// Stripe Payment Intent ID for idempotency and linking to Stripe
  stripePaymentIntentId  String?      @unique

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("USD")
  method   PaymentMethod @default(CASH)
  status   PaymentStatus @default(COMPLETED)
  note     String?

  recordedByUserId String?
  recordedByUser   User?   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  refunds Refund[]

  @@index([organizationId, createdAt])
  @@index([organizationId, memberId, createdAt])
  @@index([organizationId, membershipId])
  @@index([organizationId, branchId, createdAt])
  @@map("payments")
}

/// A refund against a Payment. Never mutates or deletes the original
/// Payment row -- the original amount stays the historical record of what
/// was actually charged; refunds are what were given back, tracked
/// separately so both numbers stay independently auditable.
model Refund {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)
  reason String?

  recordedByUserId String?
  recordedByUser   User?   @relation("RefundRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([paymentId])
  @@map("refunds")
}

/// Personal training sessions booked between members and trainers
model PtSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation("PtSession", fields: [organizationId], references: [id], onDelete: Cascade)

  memberId       String
  member         Member       @relation("PtSession", fields: [memberId], references: [id], onDelete: Cascade)

  /// Optional trainer - if null, session is unassigned or self-guided
  trainerId      String?
  trainer        StaffProfile? @relation("PtSession", fields: [trainerId], references: [id])

  branchId       String
  branch         Branch       @relation("PtSession", fields: [branchId], references: [id], onDelete: Cascade)

  startTime      DateTime
  endTime        DateTime

  /// Type of session: personal, partner, or small group training
  type           PtSessionType  @default(PERSONAL_TRAINING)

  /// Current status of the session
  status         PtSessionStatus @default(SCHEDULED)

  /// Price charged for this session (nullable for comp/internal sessions)
  price          Decimal?     @db.Decimal(10, 2)

  /// Whether payment has been collected for this session
  isPaid         Boolean      @default(false)

  /// Trainer notes for the session
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, branchId, startTime])
  @@index([memberId, startTime])
  @@index([trainerId, startTime])
  @@map("pt_sessions")
}

enum PtSessionType {
  PERSONAL_TRAINING
  PARTNER_TRAINING
  SMALL_GROUP
}

enum PtSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ----------------------------------------------------------------------------
// Workout / PT engine -- v1 scope. The module README originally described a
// Program -> Phase -> Week -> Day -> Workout -> Exercise -> Set hierarchy;
// that's periodization-app depth and would be over-engineering for a first
// real implementation (see docs, "avoid over-engineering"). This models
// what a trainer actually needs day one: an exercise library, a named plan
// (ordered exercises with sets/reps/rest), and assigning a plan to a
// member with status tracking. The deeper hierarchy can layer on top later
// without touching this shape -- a "Phase" would become a grouping of
// WorkoutPlans, not a rewrite of this model.
// ----------------------------------------------------------------------------

/// An organization's exercise library entry (custom per org, not a shared
/// global catalog in v1 -- gyms name/organize exercises differently enough
/// that a shared catalog would need a "my gym's variant of this" escape
/// hatch anyway; simpler to let each org own its list).
model Exercise {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  muscleGroup String?
  equipment   String?
  description String?
  videoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("exercises")
}

/// A named, reusable workout program a trainer builds. `exercises` is a
/// denormalized JSON array (`[{exerciseId, name, sets, reps, restSeconds,
/// order, notes}]`) rather than a join table: v1 has no requirement to
/// query "which plans use exercise X" relationally, and a plan's exercise
/// list is always read/written as one unit (the whole plan), never
/// per-exercise-row -- the same reasoning MembershipPlan.benefits (a
/// String[]) already uses for simple list data owned by one parent.
model WorkoutPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  exercises   Json    @default("[]")

  createdByUserId String?
  createdByUser   User?   @relation("WorkoutPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments WorkoutAssignment[]

  @@index([organizationId])
  @@map("workout_plans")
}

enum WorkoutAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A WorkoutPlan assigned to a specific member. A plan can be assigned to
/// many members (it's a reusable template); each assignment tracks its own
/// status independently.
model WorkoutAssignment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workoutPlanId  String
  workoutPlan    WorkoutPlan  @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedByUser   User?   @relation("WorkoutAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  status    WorkoutAssignmentStatus @default(ACTIVE)
  startDate DateTime                @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@index([workoutPlanId])
  @@map("workout_assignments")
}

// ----------------------------------------------------------------------------
// CRM / leads -- v1 scope. The module README also mentions campaigns and
// referrals; those are deferred (no pipeline-adjacent value without an
// actual lead pipeline existing first). This models the pipeline itself:
// New -> Contacted -> Qualified -> Trial -> Won/Lost, follow-up tasks, and
// converting a won lead into a real Member.
// ----------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  TRIAL
  WON
  LOST
}

/// A prospect who hasn't (yet) become a Member. `status` moves through the
/// pipeline via PATCH /leads/:id/status; WON is set only by the /convert
/// endpoint (never directly), so "WON" and "has a linked Member" can never
/// drift apart.
model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?

  assignedToUserId String?
  assignedToUser   User?   @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// Set only by POST /leads/:id/convert, at the same time status becomes
  /// WON -- see the module comment above.
  convertedMemberId String?   @unique
  convertedMember   Member?   @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps LeadFollowUp[]

  @@index([organizationId, status])
  @@index([assignedToUserId])
  @@map("leads")
}

/// A scheduled task against a lead ("call back Tuesday", "send pricing").
/// Reachable only nested under its lead (no standalone global list) -- a
/// follow-up has no meaning detached from the lead it's about.
model LeadFollowUp {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  dueAt       DateTime
  note        String
  completedAt DateTime?

  createdByUserId String?
  createdByUser   User?   @relation("LeadFollowUpCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId, dueAt])
  @@map("lead_follow_ups")
}

// ----------------------------------------------------------------------------
// Nutrition engine -- v1 scope, mirrors the Workouts v1 shape exactly (see
// that section's comment): a food library, named diet plans (a flat list
// of food items with quantities as JSON, not a versioned/relational meal
// hierarchy), and assigning a plan to a member with status tracking.
// ----------------------------------------------------------------------------

/// An organization's food/ingredient library entry, same reasoning as
/// Exercise: custom per org, no shared global catalog in v1.
model FoodItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  servingSize String? // e.g. "100g", "1 cup"
  calories    Int?
  proteinG    Decimal? @db.Decimal(6, 2)
  carbsG      Decimal? @db.Decimal(6, 2)
  fatG        Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("food_items")
}

/// A named, reusable diet plan. `items` is a denormalized JSON array
/// (`[{foodItemId, quantity, unit, mealSlot, notes}]`) for the same reason
/// WorkoutPlan.exercises is JSON, not a join table -- see that model's
/// comment. Optional daily macro targets live directly on the plan since
/// there's exactly one set of targets per plan, not a many-side relation.
model DietPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  items       Json    @default("[]")

  targetCalories Int?
  targetProteinG Decimal? @db.Decimal(6, 2)
  targetCarbsG   Decimal? @db.Decimal(6, 2)
  targetFatG     Decimal? @db.Decimal(6, 2)

  createdByUserId String?
  createdByUser   User?   @relation("DietPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DietAssignment[]

  @@index([organizationId])
  @@map("diet_plans")
}

enum DietAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// A DietPlan assigned to a specific member -- same shape as
/// WorkoutAssignment.
model DietAssignment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dietPlanId     String
  dietPlan       DietPlan     @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedByUser   User?   @relation("DietAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  status    DietAssignmentStatus @default(ACTIVE)
  startDate DateTime             @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@index([dietPlanId])
  @@map("diet_assignments")
}

/// v1 inventory scope: a flat product catalog with a running
/// `quantityOnHand` and an append-only StockMovement ledger. No
/// suppliers/purchase-order workflow yet -- see inventory/README.md.
model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?
  category    String?

  unitPrice Decimal  @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)

  quantityOnHand Int     @default(0)
  reorderLevel   Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  DAMAGED
}

/// Append-only ledger entry. `quantity` is the *signed* delta actually
/// applied to Product.quantityOnHand at the time this row was written
/// (positive for RESTOCK/positive ADJUSTMENT, negative for SALE/DAMAGED/
/// negative ADJUSTMENT) -- so summing this column for a product always
/// reconstructs its current quantityOnHand.
model StockMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     StockMovementType
  quantity Int
  note     String?

  recordedByUserId String?
  recordedByUser   User?   @relation("StockMovementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([productId])
  @@map("stock_movements")
}

// ----------------------------------------------------------------------------
// AI usage/cost tracking
// ----------------------------------------------------------------------------

enum AiUsageStatus {
  SUCCESS
  ERROR
}

/// One row per user-facing AI request (e.g. one POST /ai/chat call, tokens
/// summed across every provider round-trip the tool-calling loop made for
/// it) -- not one row per provider call. This is what
/// docs/ai/architecture.md's cost-control section requires before AI usage
/// can be enforced as a plan-limited resource (docs/saas/plans-and-limits.md)
/// and is the only visibility into AI spend this system has today; a failed
/// provider call is still logged (status ERROR) so an outage or a
/// misconfigured key shows up in usage data, not just server logs. Writing
/// this row must never be able to fail the actual AI response -- see
/// AiUsageService.record()'s try/catch.
model AiUsageLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation("AiUsageActor", fields: [userId], references: [id], onDelete: SetNull)

  /// Stable label for the AI entry point, e.g. "chat" -- lets usage be
  /// broken down per feature as more AI surfaces are added.
  feature  String
  provider String
  model    String?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  /// USD, when the provider reports generation cost; null if unknown --
  /// never guessed/estimated from a static per-model table, to avoid a
  /// silently-wrong number entering plan-limit enforcement.
  costUsd          Decimal? @db.Decimal(10, 6)

  latencyMs    Int
  status       AiUsageStatus
  errorMessage String?

  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}

// ----------------------------------------------------------------------------
// Member 360 -- Assessments and Goals. Gated by the same members.read/
// members.read_assigned/members.update permissions as the rest of Member
// 360 (not their own assessments.*/goals.* keys), so a TRAINER restricted
// to members.read_assigned can't see another trainer's client's
// assessments/goals by going around that restriction through a broader
// permission -- see MemberAssessmentsService/MemberGoalsService, which
// both re-run MembersService.getOne() the same way member-details.service
// does. Progress photos are deliberately NOT modeled here -- they need the
// files/ object-storage seam first, same reasoning as Documents (see
// docs/architecture/discovery-report.md §6).
// ----------------------------------------------------------------------------

enum MemberAssessmentType {
  INITIAL
  PROGRESS
  PAR_Q
  FITNESS_TEST
  CUSTOM
}

/// The parent record for one assessment session -- a screening, a set of
/// measurements, a battery of fitness tests, or a mix, all conducted at
/// the same time by the same staff member. Measurements/fitness-test
/// results/screenings can optionally reference one (assessmentId), or
/// stand alone (e.g. a quick weekly weigh-in isn't a full assessment).
model MemberAssessment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type  MemberAssessmentType
  notes String?

  conductedByUserId String?
  conductedByUser   User?    @relation("AssessmentConductedBy", fields: [conductedByUserId], references: [id], onDelete: SetNull)
  conductedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements   MemberMeasurement[]
  fitnessResults MemberFitnessTestResult[]
  screening      MemberScreening?

  @@index([organizationId, memberId, conductedAt])
  @@map("member_assessments")
}

/// Body measurements / composition at a point in time. Historical by
/// design -- every entry is a new row, never an update to a previous one,
/// so a member's measurement trend over time is just this table ordered
/// by recordedAt, not reconstructed from anywhere else.
model MemberMeasurement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assessmentId   String?
  assessment     MemberAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  recordedAt DateTime @default(now())

  weightKg               Decimal? @db.Decimal(6, 2)
  heightCm               Decimal? @db.Decimal(6, 2)
  bodyFatPercent         Decimal? @db.Decimal(5, 2)
  muscleMassKg           Decimal? @db.Decimal(6, 2)
  waistCm                Decimal? @db.Decimal(6, 2)
  hipCm                  Decimal? @db.Decimal(6, 2)
  chestCm                Decimal? @db.Decimal(6, 2)
  restingHeartRate       Int?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  notes                  String?

  recordedByUserId String?
  recordedByUser   User?   @relation("MeasurementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, recordedAt])
  @@map("member_measurements")
}

/// A single fitness-test result (e.g. "1RM Bench Press", "VO2 Max
/// Estimate", "Plank Hold"). `testName` is free text rather than an enum
/// -- the set of tests a gym runs is inherently open-ended/custom, per the
/// master spec's "custom assessments" requirement -- so trend-over-time
/// queries group by (memberId, testName), not by a fixed catalog id.
model MemberFitnessTestResult {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assessmentId   String?
  assessment     MemberAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  testName String
  value    Decimal @db.Decimal(10, 2)
  unit     String
  notes    String?

  recordedAt       DateTime @default(now())
  recordedByUserId String?
  recordedByUser   User?    @relation("FitnessTestRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, testName, recordedAt])
  @@map("member_fitness_test_results")
}

/// PAR-Q (Physical Activity Readiness Questionnaire) or an equivalent
/// health screening. `responses` is a small fixed-shape JSON object
/// (question key -> boolean) rather than its own table -- PAR-Q's
/// question set is standardized and doesn't need per-question rows.
/// `assessmentId` is unique: a screening belongs to at most one assessment
/// session (the 1:1 side of MemberAssessment.screening).
model MemberScreening {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assessmentId   String?           @unique
  assessment     MemberAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  responses                  Json
  flaggedForMedicalClearance Boolean @default(false)
  notes                      String?

  completedAt      DateTime @default(now())
  recordedByUserId String?
  recordedByUser   User?    @relation("ScreeningRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, completedAt])
  @@map("member_screenings")
}

enum MemberGoalCategory {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  GENERAL_FITNESS
  OTHER
}

enum MemberGoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
  PAUSED
}

model MemberGoal {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    MemberGoalCategory @default(GENERAL_FITNESS)
  status      MemberGoalStatus   @default(ACTIVE)

  targetValue   Decimal? @db.Decimal(10, 2)
  targetUnit    String?
  baselineValue Decimal? @db.Decimal(10, 2)

  startDate  DateTime  @default(now())
  targetDate DateTime?
  achievedAt DateTime?

  createdByUserId String?
  createdByUser   User?   @relation("GoalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones MemberGoalMilestone[]

  @@index([organizationId, memberId, status])
  @@map("member_goals")
}

/// Progress checkpoints toward a goal -- this table *is* the goal's
/// history/progress trail, so MemberGoal itself doesn't need a separate
/// history table the way status/branch/trainer do (see the model comment
/// on MemberStatusHistory above for that pattern).
model MemberGoalMilestone {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId         String
  goal           MemberGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title      String
  targetDate DateTime?
  achievedAt DateTime?
  value      Decimal?  @db.Decimal(10, 2)
  note       String?

  createdAt DateTime @default(now())

  @@index([organizationId, goalId])
  @@map("member_goal_milestones")
}

// ----------------------------------------------------------------------------
// Object storage -- the files/ seam, finally built (see
// docs/architecture/discovery-report.md's Phase D). `File` is the generic,
// tenant-scoped record of an object actually sitting in S3-compatible
// storage (src/files/); `MemberDocument` attaches one to a Member with a
// category, closing the last two deferred Member 360 items (Documents and
// Progress Photos -- the latter is just category=PROGRESS_PHOTO, not a
// separate table, since the two are the same shape). Other future
// attachment points (org logo, invoices, exercise media) reuse `File` the
// same way -- a new join table per attachment point, not a new storage
// abstraction each time.
// ----------------------------------------------------------------------------

enum FilePurpose {
  MEMBER_DOCUMENT
  PROFILE_PHOTO
  OTHER
}

/// The object-storage record. `key` is the S3 object key (never exposed to
/// clients directly -- API responses always carry a short-lived signed URL,
/// generated on read, never stored). Deleting a File deletes the
/// underlying S3 object in the same request (FileStorageService.delete) --
/// this row is not kept as history once that happens, unlike most
/// financial/audit tables in this schema, because a deleted upload has no
/// "what was it" value once the bytes are gone.
model File {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key          String
  originalName String
  mimeType     String
  sizeBytes    Int
  purpose      FilePurpose

  uploadedByUserId String?
  uploadedByUser   User?   @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  memberDocument MemberDocument?

  @@index([organizationId])
  @@map("files")
}

enum MemberDocumentCategory {
  DOCUMENT
  PROGRESS_PHOTO
  ID_SCAN
  OTHER
}

model MemberDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fileId         String       @unique
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  category    MemberDocumentCategory
  description String?

  createdAt DateTime @default(now())

  @@index([organizationId, memberId, category])
  @@map("member_documents")
}

/// -- src/communications/ -----------------------------------------------
/// Real, provider-backed channels are added here as they're built (EMAIL
/// today via SMTP); the other three exist as typed values so a template
/// or log row can reference them, but MessageTemplate/MessageLog rows for
/// them are only ever written once a real provider exists for that
/// channel -- see src/communications/README.md.
enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

/// TRANSACTIONAL: operational/security messages about the recipient's own
/// account or purchase (welcome, password reset, membership renewal
/// reminder) -- never gated by consent, the same way this industry
/// generally treats "your receipt" differently from "our newsletter".
/// MARKETING: anything promotional -- gated by the member's latest
/// MemberConsent(type: MARKETING) before a send is even attempted.
enum MessageCategory {
  TRANSACTIONAL
  MARKETING
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  /// A MARKETING-category send whose recipient's latest MARKETING consent
  /// is `granted: false` -- never attempted, not a delivery failure.
  SKIPPED_NO_CONSENT
}

/// One row per (organization, key, channel) message template. A null
/// organizationId is the system default template CommunicationsService
/// falls back to when an org hasn't customized that key -- see
/// MessageTemplateService.resolve().
model MessageTemplate {
  id             String                @id @default(uuid())
  organizationId String?
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  channel        CommunicationChannel
  subject        String?
  body           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key, channel])
  @@index([key, channel])
  @@map("message_templates")
}

/// The delivery-status/audit record for every message
/// CommunicationsService.send() attempts -- see that service's class
/// comment. Immutable except for the status/attempts/errorMessage/sentAt
/// fields, which the sending job updates as it progresses.
model MessageLog {
  id             String               @id @default(uuid())
  /// Nullable, SetNull, mirroring AuditLog -- a platform admin
  /// (`User.organizationId: null`) can also trigger a send (e.g. their own
  /// password reset), and that message log entry should survive an
  /// organization being deleted the same way an audit entry does.
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  channel        CommunicationChannel
  category       MessageCategory
  templateKey    String
  recipient      String
  memberId       String?
  member         Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status         MessageStatus        @default(PENDING)
  attempts       Int                  @default(0)
  errorMessage   String?
  sentAt         DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([memberId])
  @@map("message_logs")
}

/// -- src/automation/ -----------------------------------------------------
/// Trigger -> Conditions -> Action -> Audit, per automation type. P1 scope
/// is notification-only (no money movement, no destructive action), so
/// there's no approval step yet -- see src/automation/README.md for why
/// "Approval-if-required" trivially resolves to "not required" for every
/// key below, and what would change that.
enum AutomationKey {
  MEMBERSHIP_RENEWAL_REMINDER
  PAYMENT_OVERDUE_REMINDER
  MEMBER_INACTIVE_RECOVERY
  LEAD_FOLLOWUP_REMINDER
  LOW_STOCK_ALERT
}

enum AutomationRunStatus {
  SENT
  SKIPPED
  FAILED
}

/// One row per automation firing against one subject entity (a membership,
/// payment, member, lead follow-up, or product) -- the audit trail the
/// master prompt requires, and the idempotency/cooldown check
/// AutomationRunService.shouldRun() queries before firing again for the
/// same (key, subjectId) pair.
model AutomationRun {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key       AutomationKey
  /// The membershipId / paymentId / memberId / leadFollowUpId / productId
  /// this run is about -- no FK, since the key determines which table it
  /// points at (a polymorphic reference, same tradeoff as AuditLog.resourceId).
  subjectId String
  status    AutomationRunStatus
  /// Why SKIPPED, or the FAILED error message, or scan-time context
  /// (e.g. {"daysUntilExpiry": 5}) -- free-form, audit/debugging only.
  detail    Json?

  createdAt DateTime @default(now())

  @@index([organizationId, key, subjectId, createdAt])
  @@map("automation_runs")
}

/// -- src/ai-actions/ (P3 "Gym Brain": Action Center) ---------------------
/// READ -> RECOMMEND -> DRAFT -> APPROVE -> EXECUTE for AI-proposed
/// changes the master prompt calls "high-risk" -- anything that alters a
/// member's real program/data, as opposed to P0-P2's AI tools, which are
/// either pure reads or create an inert, unassigned draft (a
/// WorkoutPlan/DietPlan nobody's using yet -- see src/ai/README.md's
/// "No approval queue" note for why those didn't need this). One row per
/// proposed action; never mutated back to PENDING_APPROVAL once decided.
enum AiActionType {
  ASSIGN_WORKOUT_PLAN
  ASSIGN_DIET_PLAN
}

enum AiActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AiAction {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type   AiActionType
  status AiActionStatus @default(PENDING_APPROVAL)
  /// Validated args for the eventual execution (e.g. {memberId,
  /// workoutPlanId, startDate?, notes?}) -- re-validated against the same
  /// DTO at approval time, never trusted as-is from when it was drafted.
  payload Json
  /// Human-readable explanation shown to the approver -- an approver
  /// deciding on a raw payload with no context isn't a real approval
  /// step, it's a rubber stamp.
  reasoning String?

  proposedByUserId String
  proposedByUser   User   @relation("AiActionProposedBy", fields: [proposedByUserId], references: [id], onDelete: Cascade)

  decidedByUserId String?
  decidedByUser   User?     @relation("AiActionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  rejectionReason String?

  /// The id of whatever record execution actually created (e.g. the new
  /// WorkoutAssignment.id) -- traceability from the proposal to its
  /// real-world effect, not just a status flag.
  resultResourceId String?
  errorMessage      String?
  executedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@map("ai_actions")
}

/// -- src/ai/conversations/ (P3 "Gym Brain": AI memory) -------------------
/// Was explicitly not built through P0-P2 -- see src/ai/README.md's old
/// "No conversation persistence" note and docs/database/data-retention.md's
/// AI-conversations section, which this follows: tenant-scoped, soft-delete
/// only (a user clearing their history hides it from them, never destroys
/// an org's audit trail of what the AI was asked/told), never used as
/// training data.
model AiConversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([organizationId, userId, deletedAt, updatedAt])
  @@map("ai_conversations")
}

enum AiMessageRole {
  USER
  ASSISTANT
}

/// One row per user-visible turn (not every raw tool-call/tool-result
/// exchange -- see AiService's comment on why persisted history only
/// carries the natural-language content the model actually needs re-fed
/// on the next turn, the same shape the pre-persistence client-resent
/// `history` array already used).
model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiMessageRole
  content String
  /// The tool calls made while producing this reply, if any -- kept for
  /// transcript/audit visibility only, never replayed back into a later
  /// prompt.
  toolCalls Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}
