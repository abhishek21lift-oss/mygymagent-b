NODE_ENV=test
PORT=4001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mygymagent_test?schema=public"
JWT_ACCESS_SECRET="test-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:3000"

# Points at a local s3rver instance (see README.md's "Object storage" setup
# section) -- real S3-protocol requests, not mocked, same as Postgres/Redis
# above. Credentials are s3rver's fixed defaults, not secrets.
S3_ENDPOINT="http://localhost:4568"
S3_REGION="auto"
S3_BUCKET="mygymagent-test"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"

# Points at a local SMTP capture server (test/utils/smtp-capture-server.ts,
# started/stopped by test/global-setup.ts and global-teardown.ts) -- real
# SMTP-protocol delivery, not mocked, same discipline as s3rver above.
# SMTP_TEST_PORT/SMTP_TEST_CAPTURE_FILE are read by the capture server
# itself and by test/utils/mailbox.ts; SMTP_* are what the app reads.
SMTP_TEST_PORT="2525"
SMTP_TEST_CAPTURE_FILE="test/.runtime/smtp-capture.jsonl"
SMTP_HOST="localhost"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_FROM_ADDRESS="noreply@mygymagent.test"
