NODE_ENV=test
PORT=4001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mygymagent_test?schema=public"
JWT_ACCESS_SECRET="test-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGIN="http://localhost:3000"

# Points at a local s3rver instance (see README.md's "Object storage" setup
# section) -- real S3-protocol requests, not mocked, same as Postgres/Redis
# above. Credentials are s3rver's fixed defaults, not secrets.
S3_ENDPOINT="http://localhost:4568"
S3_REGION="auto"
S3_BUCKET="mygymagent-test"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"
