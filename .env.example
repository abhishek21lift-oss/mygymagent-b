# Copy to .env and fill in real values for your environment.
# NODE_ENV: development | staging | production. Only gates a small number of
# code paths (e.g. secure cookie flag) -- staging and production run the
# identical build, differing only in these environment variables and which
# database they point at. See docs/deployment/overview.md.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT secrets - generate strong random values, never reuse across environments
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:3000"

# AI (OpenRouter) - OpenAI-compatible chat completions. Optional at boot; AI requests
# return a clear 503 until OPENROUTER_API_KEY is configured in the deployment.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# Error tracking (Sentry) - optional. Without SENTRY_DSN, 5xx errors are
# still logged server-side (via AllExceptionsFilter) but not aggregated.
SENTRY_DSN=""

# Redis - required for the background job queue (src/queue/), e.g. the
# welcome-email job enqueued on member creation. Defaults to a local
# instance; every real deployment must set this to a real Redis URL.
REDIS_URL="redis://localhost:6379"

# Object storage (src/files/) - S3-compatible, all optional together. Without
# them, upload endpoints return a clear 503 rather than failing app boot.
S3_ENDPOINT="http://localhost:4568"
S3_REGION="auto"
S3_BUCKET="mygymagent-dev"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"

# WhatsApp Business onboarding (src/whatsapp/), via Meta Cloud API - all
# optional. Unset means POST /whatsapp/integration/embedded-signup returns
# a clear 503 naming the missing variables instead of failing mid-exchange.
META_APP_ID=""
META_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v25.0"
# 32-byte hex AES-256-GCM key for the per-org WhatsApp credential vault
# (src/whatsapp/whatsapp-token.vault.ts), e.g. `openssl rand -hex 32`.
# Unset means connect/test-send return a clear 503 ("WhatsApp sending
# isn't configured") rather than failing app boot.
WHATSAPP_TOKEN_KEY=""
# Compared against Meta's hub.verify_token on GET /whatsapp/webhook.
# Must match the verify token entered in the Meta app dashboard.
META_WABA_VERIFY_TOKEN=""

# 32-byte hex AES-256-GCM key wrapping each user's TOTP secret
# (src/auth/mfa/mfa-secret.vault.ts), e.g. `openssl rand -hex 32`.
# Unset means the 2FA enrolment endpoints return a clear 503 rather than
# failing app boot. Rotating or losing this key makes every enrolled
# secret undecryptable -- users would have to re-enrol (recovery codes are
# hashed separately and keep working).
MFA_TOTP_KEY=""

# Stripe webhooks (src/payments/stripe-webhook.controller.ts) - optional at
# boot. Unset means POST /payments/webhook returns a clear 500 naming the
# missing secret rather than failing app boot.
STRIPE_WEBHOOK_SECRET=""

# Razorpay online collection (src/payments/razorpay.service.ts,
# src/invoices/) - optional at boot, same pattern as Stripe above. Unset
# means POST /payments/online/razorpay/order (and invoice
# retry-collection) return a clear 503 naming the missing variables, and
# the Razorpay webhook endpoint rejects deliveries, rather than failing
# app boot.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Member SMS OTP (src/auth/otp-delivery/) --------------------------------
# How a member's passwordless login code is produced and delivered.
#   msg91 - the real provider. A CSPRNG code generated and hashed by the
#           app, carried by SMS through a DLT-registered template. This is
#           the only value permitted in production, and the default.
#   mock  - development/test only. A fixed code, and nothing is sent.
#
# `mock` exists so the OTP flow (request, verify, expiry, the session it
# starts) can be exercised without a carrier account, a DLT template, or
# a handset. It is still hashed, still expiring, still attempt-counted --
# it exercises the real flow rather than skipping past it.
#
# PRODUCTION REFUSES TO BOOT with OTP_PROVIDER=mock, or with MOCK_OTP set
# at all, even alongside msg91. A fixed publicly-known code in front of a
# login is not a misconfiguration to warn about, it is a way in, so the
# process will not start.
OTP_PROVIDER="msg91"
# The code the mock provider hands out. Six digits. Defaults to 123456
# when unset, so it rarely needs setting at all. Left commented out on
# purpose: production rejects MOCK_OTP outright, so a copy of this file
# flipped to NODE_ENV=production would fail to boot over a value the
# operator never meant to set. Uncomment for local development only.
# MOCK_OTP="123456"
# How long a code stays spendable, in seconds. 30-900. Default 300 (5
# minutes). This is the window an attacker has to guess, and a member
# only has to type six digits, so there is no reason for a longer one.
OTP_EXPIRY_SECONDS=300

# MSG91 credentials, required by OTP_PROVIDER=msg91 and optional
# otherwise. SMS is DLT-regulated in India: MSG91_OTP_TEMPLATE_ID is the
# operator-registered template and MSG91_OTP_VAR the variable inside it
# the code fills in (the name is fixed at template registration, not by
# us). Without both, member OTP login returns a clear 400 saying SMS login
# is not configured, rather than issuing a code that cannot arrive.
# MSG91_AUTH_KEY=""
# MSG91_OTP_TEMPLATE_ID=""
# MSG91_SENDER_ID=""
# MSG91_OTP_VAR="otp"
# MSG91_FLOW_URL="https://control.msg91.com/api/v5/flow/"

# Push notifications over Firebase Cloud Messaging. Firebase console ->
# Project settings -> Service accounts -> Generate new private key, then
# paste the whole JSON file here (raw, or base64 if your host mangles
# newlines). Unset means push is off: devices still register, and each
# attempted push is recorded FAILED in message_logs rather than dropped.
# FCM_SERVICE_ACCOUNT_JSON=""
# FCM_DEFAULT_TITLE="THE CULT CLIENT"
