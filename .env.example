# Copy to .env and fill in real values for your environment.
# NODE_ENV: development | staging | production. Only gates a small number of
# code paths (e.g. secure cookie flag) -- staging and production run the
# identical build, differing only in these environment variables and which
# database they point at. See docs/deployment/overview.md.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT secrets - generate strong random values, never reuse across environments
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:3000"

# AI (OpenRouter) - optional. Without OPENROUTER_API_KEY, POST /ai/chat
# returns a 503 rather than the app failing to boot. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Error tracking (Sentry) - optional. Without SENTRY_DSN, 5xx errors are
# still logged server-side (see AllExceptionsFilter) but not aggregated or
# alerted on anywhere. Get a DSN at https://sentry.io
SENTRY_DSN=""

# Redis - required for the background job queue (src/queue/), e.g. the
# welcome-email job enqueued on member creation. Defaults to a local
# instance; every real deployment must set this to a real Redis URL
# (e.g. a managed Redis add-on). A missing/unreachable Redis does not
# crash the app or fail the request that tried to enqueue a job -- see
# src/queue/queue.module.ts -- but jobs silently won't run.
REDIS_URL="redis://localhost:6379"

# Object storage (src/files/) - S3-compatible, all optional together. Without
# them, upload endpoints (e.g. member documents) return a clear 503 rather
# than the app failing to boot -- see src/files/file-storage.service.ts.
# Cloudflare R2 in production; a local s3rver instance in development and
# tests (see README.md's "Object storage" setup section) -- the values below
# are s3rver's fixed local defaults, not secrets.
S3_ENDPOINT="http://localhost:4568"
S3_REGION="auto"
S3_BUCKET="mygymagent-dev"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"
