# Copy to .env and fill in real values for your environment.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT secrets
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# AI (optional)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Redis
REDIS_URL="redis://localhost:6379"

# Object storage (optional)
S3_ENDPOINT="http://localhost:4568"
S3_REGION="auto"
S3_BUCKET="mygymagent-dev"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_ADDRESS=""

# WhatsApp Cloud API / Meta Embedded Signup
# WHATSAPP_ENCRYPTION_KEY protects customer access tokens at rest.
WHATSAPP_ENCRYPTION_KEY="generate-a-long-random-secret"
# Token used by Meta to verify GET /whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN="generate-a-random-verification-token"
# Keep this configurable because Meta Graph API versions change.
WHATSAPP_GRAPH_VERSION="v25.0"
# Required for server-side Embedded Signup code exchange and webhook HMAC validation.
META_APP_ID=""
META_APP_SECRET=""
